# Database
MONGODB_URI=mongodb://localhost:27017/hostel_management

# Authentication (Generate with: openssl rand -base64 32)
JWT_SECRET=replace_with_a_secure_random_256_bit_secret_key
JWT_EXPIRE=30d

# Server Configuration
PORT=4000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AWS S3 Storage (For KYC documents and hostel photos)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=your-bucket-name

# Centralized Email Configuration
EMAIL_FROM=noreply@hostelzify.com
EMAIL_FROM_NAME=Hostelzify
SUPPORT_EMAIL=support@hostelzify.com
APP_URL=http://localhost:3000

# SMTP Email Service Provider
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
# Google Maps API (For Geofencing and Geocoding)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Public API Base URL
API_BASE_URL=http://localhost:4000
